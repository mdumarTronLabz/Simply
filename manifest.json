{
  "manifest_version": 3,
  "name": "Simply",
  "version": "1.0.0",
  "description": "Your messages, one click away.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.whatsapp.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*","assets/*.ttf"],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.whatsapp.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.whatsapp.com/*"
      ],
      "js": ["src/content/index.jsx"],
      "run_at": "document_idle"
    }
  ]
}
